<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- « Je le sens » et la respiration guidée font vibrer le téléphone -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mesures en direct quand l'appli est en arrière-plan (pour le widget) : service avec une notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alerte « ton pouls monte » : s'affiche en grand même écran éteint -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Capteurs portés (ceinture cardio, bague) en Bluetooth basse consommation -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 10 et 11 : anciennes autorisations Bluetooth, et la localisation pour chercher les appareils -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- Les capteurs se rebranchent tout seuls quand le téléphone redémarre -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.MonRenard">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pouls en direct pendant que l'appli est en arrière-plan : capteurs Bluetooth, ou la démo (valeurs simulées) -->
        <service
            android:name=".LiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse|connectedDevice">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Affiche sur le widget le pouls mesuré en direct pendant que l'appli est en arrière-plan" />
        </service>

        <!-- Après une mise à jour ou un redémarrage : les capteurs reviennent sans rien faire -->
        <receiver
            android:name=".SensorsRestart"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Boutons « Arrêter » et « Pas maintenant » de la notification d'alerte -->
        <receiver
            android:name=".PulseAlert$Receiver"
            android:exported="false" />

        <!-- Petit widget : le renard seul -->
        <receiver
            android:name=".FoxWidgetSmall"
            android:exported="false"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <!-- Grand widget : le renard, son humeur et deux raccourcis -->
        <receiver
            android:name=".FoxWidgetLarge"
            android:exported="false"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>
    </application>
</manifest>
