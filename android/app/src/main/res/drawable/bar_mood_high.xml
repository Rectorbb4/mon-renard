<?xml version="1.0" encoding="utf-8"?>
<!-- Moitié droite de la jauge d'humeur : elle se remplit depuis le milieu (à gauche) vers la droite. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:bottomRightRadius="4dp" android:topRightRadius="4dp" />
                    <solid android:color="@color/gauge_track" />
                </shape>
            </item>
            <!-- La zone d'équilibre (humeur en dessous de 0,25) -->
            <item android:gravity="start|fill_vertical" android:width="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gauge_calm" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <corners android:bottomRightRadius="4dp" android:topRightRadius="4dp" />
                <solid android:color="@color/accent" />
            </shape>
        </clip>
    </item>
</layer-list>
