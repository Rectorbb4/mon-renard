<?xml version="1.0" encoding="utf-8"?>
<!-- Grand widget : le renard animé sans fond à gauche, une carte avec l'humeur et les deux boutons à droite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <include
            layout="@layout/widget_fox"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/zz"
            style="@style/WidgetSleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="4dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1.15"
        android:background="@drawable/widget_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/mood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_default_label"
            android:textColor="@color/widget_fg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/widget_default_caption"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_checkin"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/btn_checkin_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_checkin"
            android:textColor="@color/accent_fg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_feel"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_feel_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_feel"
            android:textColor="@color/felt"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
